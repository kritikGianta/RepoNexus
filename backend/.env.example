# ==============================================================
# RepoNexus backend configuration
# ==============================================================
# cp backend/.env.example backend/.env   (or run scripts/bootstrap-env)
# Never commit backend/.env.
#
# When running with Docker Compose, DATABASE_URL, REDIS_URL,
# TASK_EXECUTION_MODE, MLFLOW_TRACKING_URI, CORS_ORIGINS and
# GITHUB_REDIRECT_URI are set by docker-compose.yml and the values
# below are only used for running the API directly on your machine.
# ==============================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Required secrets ───────────────────────────────────────────
# JWT signing secret (>= 32 chars):
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-this-with-a-very-long-random-secret-string-minimum-32-chars
# Fernet key used to encrypt GitHub tokens at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-this-with-a-valid-fernet-generated-key=

# ── GitHub OAuth App (required to sign in) ─────────────────────
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:               http://localhost:8080
#   Authorization callback URL: http://localhost:8080/auth/github/callback
#   (use http://localhost:5175/... instead when running `npm run dev`)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:5175/auth/github/callback
# Shared secret for push webhooks (required in production)
GITHUB_WEBHOOK_SECRET=

# ── Groq LLM (required for AI features) ────────────────────────
# Free keys: https://console.groq.com. Several keys may be given
# comma-separated; they are rotated automatically on rate limits.
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_KEYS=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# ── Local (non-Docker) runtime ─────────────────────────────────
# SQLite needs no server. To use the Compose MySQL from your machine instead:
#   DATABASE_URL=mysql+aiomysql://reponexus:reponexus@localhost:3306/reponexus?charset=utf8mb4
DATABASE_URL=sqlite+aiosqlite:///./reponexus.db
REDIS_URL=redis://localhost:6379/0
# inline = run analyses inside the API process (no Redis needed)
# celery = dispatch to the Celery worker
TASK_EXECUTION_MODE=inline
# Leave empty to disable experiment tracking
MLFLOW_TRACKING_URI=
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5175,http://localhost:8080

# ── Tuning ─────────────────────────────────────────────────────
DEFAULT_PLAN_TIER=free
MAX_FILES_PER_ANALYSIS=200
MAX_AI_ENRICHMENTS=10
CELERY_TASK_TIME_LIMIT_SECONDS=3600
RATE_LIMIT_ENABLED=true
